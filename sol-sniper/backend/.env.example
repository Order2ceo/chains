# ── SOL Sniper Bot configuration ─────────────────────────────────────
# Copy this file to ".env" (same folder) and fill in your real values.
# NEVER commit your real .env — it contains your wallet private key.

# Solana RPC endpoint. Use a dedicated/paid RPC — the free public RPC is
# rate-limited (HTTP 429) under continuous scanning.
# Helius: https://dashboard.helius.dev  (create app → copy HTTPS RPC URL)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Base58 private key of a DEDICATED BURNER wallet (small funds only).
# In Phantom: create a NEW account → ⋮ → Account Details → Show Private Key.
# Do NOT use your main wallet.
SOLANA_WALLET_PRIVATE_KEY=YOUR_BURNER_WALLET_BASE58_KEY_HERE

# ── Trading behaviour ────────────────────────────────────────────────
# LIVE_MODE=true sends REAL transactions. false = dry-run (no funds move).
LIVE_MODE=true

# Auto-buy detected tokens that pass the safety filters.
AUTO_BUY_ENABLED=true

# Auto-sell on take-profit / stop-loss / trailing-stop.
AUTO_SELL_ENABLED=true

# Start the scanner automatically on boot (no manual click needed).
SCANNER_AUTOSTART=true

# SOL spent per buy. Keep small — this is your max risk per trade.
BUY_AMOUNT_SOL=0.02

# Exit targets (percent).
TAKE_PROFIT_PCT=100
STOP_LOSS_PCT=30
